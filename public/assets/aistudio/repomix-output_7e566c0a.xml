<file path="apps/web/src/utils/share.ts">
/**
 * Utilities for parsing incoming Web Share Target payloads (e.g. from iOS/Android share sheets).
 */

export interface SharedPayload {
  targetUrl: string | null;
  title: string | null;
  text: string | null;
}

const URL_REGEX = /https?:\/\/[^\s"'<>]+/i;

/**
 * Extracts candidate URL and title from Web Share Target URLSearchParams.
 * Mobile apps frequently combine URLs and captions into the `text` field.
 */
export function extractSharedPayload(params: URLSearchParams): SharedPayload {
  const rawUrl = params.get("url")?.trim() || "";
  const rawText = params.get("text")?.trim() || "";
  const rawTitle = params.get("title")?.trim() || "";

  let detectedUrl: string | null = null;

  // 1. Check if rawUrl itself is valid
  if (rawUrl && /^https?:\/\//i.test(rawUrl)) {
    detectedUrl = rawUrl;
  }

  // 2. If not found, look for URL in text
  if (!detectedUrl && rawText) {
    const match = rawText.match(URL_REGEX);
    if (match && match[0]) {
      detectedUrl = match[0];
    }
  }

  // 3. If still not found, look for URL in title
  if (!detectedUrl && rawTitle) {
    const match = rawTitle.match(URL_REGEX);
    if (match && match[0]) {
      detectedUrl = match[0];
    }
  }

  // Clean trailing punctuation from detected URL (e.g. trailing period, parenthesis)
  if (detectedUrl) {
    detectedUrl = detectedUrl.replace(/[.,;:!?)>]+$/, "");
  }

  // Use remaining non-URL text or title as link title/label
  let derivedTitle: string | null = rawTitle || null;
  if (!derivedTitle && rawText && detectedUrl && rawText !== detectedUrl) {
    const textWithoutUrl = rawText.replace(detectedUrl, "").trim();
    if (textWithoutUrl) {
      derivedTitle = textWithoutUrl;
    }
  }

  return {
    targetUrl: detectedUrl,
    title: derivedTitle,
    text: rawText || null,
  };
}
</file>

<file path="apps/web/src/utils/transfer.ts">
import {
  EXPORT_SCHEMA_VERSION,
  type ImportLinkInput,
  type LinksExportEnvelope,
} from "@redirect/shared";
import { exportAllLinks } from "@/api/client";

export function downloadJsonFile(data: unknown, filename: string): void {
  const json = JSON.stringify(data, null, 2);
  const blob = new Blob([json], { type: "application/json;charset=utf-8" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

export async function exportAndDownloadLinks(options?: {
  search?: string;
  tag?: string;
  isActive?: "true" | "false";
  onProgress?: (fetchedCount: number) => void;
}): Promise<LinksExportEnvelope> {
  const envelope = await exportAllLinks(options);
  const datePart = envelope.exportedAt.slice(0, 10);
  downloadJsonFile(envelope, `redirect-links-${datePart}.json`);
  return envelope;
}

export function parseImportEnvelope(
  rawText: string
): { ok: true; links: ImportLinkInput[] } | { ok: false; error: string } {
  let parsed: unknown;
  try {
    parsed = JSON.parse(rawText);
  } catch {
    return { ok: false, error: "Invalid JSON file. Please upload a valid JSON export." };
  }

  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
    return {
      ok: false,
      error: "Import file must be a JSON object with 'version' and 'links' fields.",
    };
  }

  const record = parsed as Record<string, unknown>;
  if (record["version"] !== EXPORT_SCHEMA_VERSION) {
    return {
      ok: false,
      error: `Unsupported export version (${String(record["version"] ?? "missing")}). Expected version ${EXPORT_SCHEMA_VERSION}.`,
    };
  }

  if (!Array.isArray(record["links"])) {
    return { ok: false, error: "Import JSON must contain a 'links' array." };
  }

  if (record["links"].length === 0) {
    return { ok: false, error: "The 'links' array in this file is empty." };
  }

  return { ok: true, links: record["links"] as ImportLinkInput[] };
}
</file>

<file path="apps/web/src/utils/url.ts">
/**
 * Normalizes user URL input by trimming whitespace and prepending https:// if no scheme is provided.
 */
export function normalizeUrlInput(raw: string): string {
  const trimmed = raw.trim();
  if (!trimmed) {
    return "";
  }
  if (!/^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(trimmed)) {
    return `https://${trimmed}`;
  }
  return trimmed;
}
