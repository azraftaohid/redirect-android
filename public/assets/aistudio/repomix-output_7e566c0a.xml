<file path="apps/web/src/components/DailyChart.tsx">
import React, { useState, useRef, useEffect } from "react";
import type { DailyClickPoint } from "@/utils/stats";
import { formatUtcDay } from "@/utils/stats";

interface DailyChartProps {
  data: DailyClickPoint[];
  days: number;
}

export function DailyChart({ data, days }: DailyChartProps): React.ReactElement {
  const [hoverIndex, setHoverIndex] = useState<number | null>(null);
  const svgRef = useRef<SVGSVGElement | null>(null);

  const [isMobile, setIsMobile] = useState<boolean>(() => {
    if (typeof window !== "undefined" && window.matchMedia) {
      return window.matchMedia("(max-width: 640px)").matches;
    }
    return false;
  });

  useEffect(() => {
    if (typeof window === "undefined" || !window.matchMedia) return;
    const mql = window.matchMedia("(max-width: 640px)");
    const onChange = (e: MediaQueryListEvent) => {
      setIsMobile(e.matches);
    };
    mql.addEventListener("change", onChange);
    return () => mql.removeEventListener("change", onChange);
  }, []);

  if (!data || data.length === 0) {
    return (
      <div className="h-48 sm:h-60 flex items-center justify-center text-xs text-zinc-400">
        No timeseries data available
      </div>
    );
  }

  // Adjust aspect ratio and height for mobile screens so graph doesn't render too small
  const width = isMobile ? 480 : 800;
  const height = isMobile ? 280 : 260;
  const paddingLeft = isMobile ? 36 : 45;
  const paddingRight = isMobile ? 12 : 20;
  const paddingTop = isMobile ? 20 : 25;
  const paddingBottom = isMobile ? 30 : 35;

  const plotWidth = width - paddingLeft - paddingRight;
  const plotHeight = height - paddingTop - paddingBottom;

  const rawMax = Math.max(...data.map((d) => d.clicks));
  // Round max up to neat round number
  const maxClicks = Math.max(5, Math.ceil(rawMax * 1.15));

  const isAreaChart = days > 30;

  // Coordinate mapping
  const getX = (index: number) => {
    if (data.length === 1) return paddingLeft + plotWidth / 2;
    return paddingLeft + (index / (data.length - 1)) * plotWidth;
  };

  const getY = (clicks: number) => {
    return paddingTop + plotHeight - (clicks / maxClicks) * plotHeight;
  };

  // Pointer interaction
  const handlePointerMove = (e: React.PointerEvent<SVGSVGElement>) => {
    if (!svgRef.current) return;
    const rect = svgRef.current.getBoundingClientRect();
    const clientX = e.clientX - rect.left;
    const ratio = Math.max(0, Math.min(1, (clientX - paddingLeft * (rect.width / width)) / (plotWidth * (rect.width / width))));
    const index = Math.round(ratio * (data.length - 1));
    if (index >= 0 && index < data.length) {
      setHoverIndex(index);
    }
  };

  const handlePointerLeave = () => {
    setHoverIndex(null);
  };

  // Build SVG path for Area Chart
  const linePoints = data.map((d, i) => `${getX(i)},${getY(d.clicks)}`).join(" L ");
  const linePath = `M ${linePoints}`;
  const areaPath = `M ${getX(0)},${paddingTop + plotHeight} L ${linePoints} L ${getX(
    data.length - 1
  )},${paddingTop + plotHeight} Z`;

  // X Axis tick intervals
  const tickCount = Math.min(isMobile ? 4 : 6, data.length);
  const tickStep = Math.max(1, Math.floor((data.length - 1) / (tickCount - 1)));
  const xTicks: number[] = [];
  for (let i = 0; i < data.length; i += tickStep) {
    xTicks.push(i);
  }
  if (!xTicks.includes(data.length - 1)) {
    xTicks.push(data.length - 1);
  }

  const activePoint = hoverIndex !== null ? data[hoverIndex] : null;
  const activeX = hoverIndex !== null ? getX(hoverIndex) : 0;
  const activeY = activePoint ? getY(activePoint.clicks) : 0;

  return (
    <div className="relative w-full select-none">
      <svg
        ref={svgRef}
        viewBox={`0 0 ${width} ${height}`}
        className="w-full h-auto overflow-visible cursor-crosshair touch-none"
        onPointerMove={handlePointerMove}
        onPointerLeave={handlePointerLeave}
      >
        <defs>
          <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="currentColor" stopOpacity="0.25" className="text-zinc-900 dark:text-zinc-100" />
            <stop offset="100%" stopColor="currentColor" stopOpacity="0.0" className="text-zinc-900 dark:text-zinc-100" />
          </linearGradient>
        </defs>

        {/* Y Grid lines */}
        {[0, 0.5, 1].map((pct) => {
          const y = paddingTop + plotHeight * (1 - pct);
          const val = Math.round(maxClicks * pct);
          return (
            <g key={pct}>
              <line
                x1={paddingLeft}
                y1={y}
                x2={width - paddingRight}
                y2={y}
                stroke="currentColor"
                strokeDasharray="4 4"
                className="text-zinc-200 dark:text-zinc-800"
                strokeWidth="1"
              />
              <text
                x={paddingLeft - 8}
                y={y + 3}
                textAnchor="end"
                className="text-[10px] fill-zinc-400 font-mono select-none"
              >
                {val}
              </text>
            </g>
          );
        })}

        {/* X Axis ticks & labels */}
        {xTicks.map((i) => {
          const pt = data[i];
          if (!pt) return null;
          const x = getX(i);
          return (
            <text
              key={i}
              x={x}
              y={height - 10}
              textAnchor="middle"
              className="text-[10px] fill-zinc-400 font-mono select-none"
            >
              {formatUtcDay(pt.day)}
            </text>
          );
        })}

        {/* Chart Body: Area Chart or Bar Chart */}
        {isAreaChart ? (
          <g>
            <path d={areaPath} fill="url(#areaGradient)" />
            <path
              d={linePath}
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              className="text-zinc-900 dark:text-zinc-100"
            />
          </g>
        ) : (
          <g>
            {data.map((d, i) => {
              const xCenter = getX(i);
              const barWidth = Math.max(4, Math.min(24, (plotWidth / data.length) * 0.7));
              const x = xCenter - barWidth / 2;
              const y = getY(d.clicks);
              const barHeight = Math.max(1, paddingTop + plotHeight - y);
              const isHovered = hoverIndex === i;

              return (
                <rect
                  key={d.day}
                  x={x}
                  y={y}
                  width={barWidth}
                  height={barHeight}
                  rx="3"
                  className={
                    isHovered
                      ? "fill-zinc-950 dark:fill-zinc-50 transition-colors"
                      : "fill-zinc-300 dark:fill-zinc-700 hover:fill-zinc-500 dark:hover:fill-zinc-400 transition-colors"
                  }
                />
              );
            })}
          </g>
        )}

        {/* Hover Guide & Dot */}
        {hoverIndex !== null && activePoint && (
          <g pointerEvents="none">
            <line
              x1={activeX}
              y1={paddingTop}
              x2={activeX}
              y2={paddingTop + plotHeight}
              stroke="currentColor"
              strokeWidth="1.5"
              className="text-zinc-400 dark:text-zinc-500"
              strokeDasharray="2 2"
            />
            <circle
              cx={activeX}
              cy={activeY}
              r="4.5"
              className="fill-white dark:fill-zinc-900 stroke-zinc-900 dark:stroke-zinc-100"
              strokeWidth="2.5"
            />
          </g>
        )}
      </svg>

      {/* Floating Scrub Tooltip */}
      {hoverIndex !== null && activePoint && (
        <div
          className="absolute pointer-events-none transform -translate-x-1/2 -translate-y-full bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-xs rounded-lg px-2.5 py-1.5 shadow-lg border border-zinc-700 dark:border-zinc-300 z-10 transition-transform duration-75 flex flex-col items-center gap-0.5 whitespace-nowrap"
          style={{
            left: `${(activeX / width) * 100}%`,
            top: `${Math.max(10, (activeY / height) * 100 - 8)}%`,
          }}
        >
          <span className="font-semibold text-xs">
            {activePoint.clicks.toLocaleString()} {activePoint.clicks === 1 ? "click" : "clicks"}
          </span>
          <span className="text-[10px] opacity-75 font-mono">
            {formatUtcDay(activePoint.day)}
          </span>
        </div>
      )}
    </div>
  );
}
</file>

<file path="apps/web/src/context/AuthContext.tsx">
import React, {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useState,
} from "react";
import {
  type AuthPrincipal,
  AccessSessionExpiredError,
  ApiClientError,
  bootstrapInitialTokenPing,
  clearStoredToken,
  getStoredToken,
  getStoredTokenSetAt,
  setStoredToken,
  verifyAuth,
} from "@/api/client";

export type AuthStatus = "loading" | "unauthenticated" | "authenticated";

export interface AuthContextValue {
  status: AuthStatus;
  token: string | null;
  principal: AuthPrincipal | null;
  accessExpired: boolean;
  warning: string | null;
  login: (token: string) => Promise<void>;
  logout: () => void;
  updateActiveToken: (newToken: string) => void;
  clearAccessExpired: () => void;
}

const AuthContext = createContext<AuthContextValue | null>(null);

const KV_PROPAGATION_GRACE_MS = 60_000;

export function AuthProvider({ children }: { children: React.ReactNode }): React.ReactElement {
  const [status, setStatus] = useState<AuthStatus>("loading");
  const [token, setToken] = useState<string | null>(() => getStoredToken());
  const [principal, setPrincipal] = useState<AuthPrincipal | null>(null);
  const [accessExpired, setAccessExpired] = useState(false);
  const [warning, setWarning] = useState<string | null>(null);

  // Listen for Cloudflare Access session expiration events dispatched across the app
  useEffect(() => {
    const handleAccessExpired = () => {
      setAccessExpired(true);
    };

    window.addEventListener("redirect:access-expired", handleAccessExpired);
    return () => {
      window.removeEventListener("redirect:access-expired", handleAccessExpired);
    };
  }, []);

  // Listen for unauthorized 401 events dispatched on stored token failure
  useEffect(() => {
    const handleUnauthorized = () => {
      const setAt = getStoredTokenSetAt();
      const elapsed = Date.now() - setAt;

      if (elapsed < KV_PROPAGATION_GRACE_MS) {
        setWarning(
          "Saved token could not be verified yet. KV propagation across Cloudflare edge locations may take up to 60 seconds."
        );
        return;
      }

      clearStoredToken();
      setToken(null);
      setPrincipal(null);
      setStatus("unauthenticated");
      setWarning("Session expired or token revoked. Please log in again.");
    };

    window.addEventListener("redirect:unauthorized", handleUnauthorized);
    return () => {
      window.removeEventListener("redirect:unauthorized", handleUnauthorized);
    };
  }, []);

  // Verify stored token or trigger background bootstrap on initial load
  useEffect(() => {
    let cancelled = false;

    async function initAuth() {
      const token = getStoredToken();

      if (!token) {
        if (!cancelled) {
          setStatus("unauthenticated");
        }
        // Ping to ensure server bootstraps initial token in KV if this is first launch
        bootstrapInitialTokenPing();
        return;
      }

      try {
        const res = await verifyAuth(token);
        if (!cancelled) {
          setPrincipal(res.principal);
          setStatus("authenticated");
          setWarning(null);
        }
      } catch (err) {
        if (cancelled) return;

        if (err instanceof AccessSessionExpiredError) {
          setAccessExpired(true);
          setStatus("unauthenticated");
          return;
        }

        if (err instanceof ApiClientError && err.status === 401) {
          const setAt = getStoredTokenSetAt();
          const elapsed = Date.now() - setAt;

          if (elapsed < KV_PROPAGATION_GRACE_MS) {
            // Within KV propagation window, preserve token and notify user
            setStatus("unauthenticated");
            setWarning(
              "Saved token could not be verified yet. KV propagation across Cloudflare edge locations may take up to 60 seconds."
            );
            return;
          }

          // Beyond grace period: token is truly invalid or revoked
          clearStoredToken();
          setToken(null);
          setPrincipal(null);
          setStatus("unauthenticated");
          setWarning("Session expired or token revoked. Please log in again.");
          return;
        }

        // Generic network or server error: preserve token, show unauthenticated status
        setStatus("unauthenticated");
        setWarning(err instanceof Error ? err.message : "Authentication error occurred.");
      }
    }

    initAuth();

    return () => {
      cancelled = true;
    };
  }, []);

  const login = useCallback(async (candidateToken: string): Promise<void> => {
    const trimmed = candidateToken.trim();
    if (!trimmed) {
      throw new Error("Token cannot be empty");
    }

    const res = await verifyAuth(trimmed);
    setStoredToken(trimmed);
    setToken(trimmed);
    setPrincipal(res.principal);
    setStatus("authenticated");
    setWarning(null);
    setAccessExpired(false);
  }, []);

  const logout = useCallback((): void => {
    clearStoredToken();
    setToken(null);
    setPrincipal(null);
    setStatus("unauthenticated");
    setWarning(null);
  }, []);

  const updateActiveToken = useCallback((newToken: string): void => {
    const trimmed = newToken.trim();
    setStoredToken(trimmed);
    setToken(trimmed);
  }, []);

  const clearAccessExpired = useCallback((): void => {
    setAccessExpired(false);
  }, []);

  const value: AuthContextValue = {
    status,
    token,
    principal,
    accessExpired,
    warning,
    login,
    logout,
    updateActiveToken,
    clearAccessExpired,
  };

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
}

export function useAuth(): AuthContextValue {
  const context = useContext(AuthContext);
  if (!context) {
    throw new Error("useAuth must be used within an AuthProvider");
  }
  return context;
}
</file>

<file path="apps/web/src/utils/dates.ts">
/**
 * Date formatting and conversion utilities for local timezone and UTC handling.
 */

/**
 * Converts a UTC ISO string (e.g. from API) into the "YYYY-MM-DDTHH:mm" format
 * expected by <input type="datetime-local"> in the user's local timezone.
 */
export function toLocalDatetimeInputValue(utcIsoString?: string | null): string {
  if (!utcIsoString) return "";
  const date = new Date(utcIsoString);
  if (isNaN(date.getTime())) return "";

  const pad = (n: number) => String(n).padStart(2, "0");
  const year = date.getFullYear();
  const month = pad(date.getMonth() + 1);
  const day = pad(date.getDate());
  const hours = pad(date.getHours());
  const minutes = pad(date.getMinutes());

  return `${year}-${month}-${day}T${hours}:${minutes}`;
}

/**
 * Converts a local datetime-local input string ("YYYY-MM-DDTHH:mm")
 * into a UTC ISO string (e.g. "2026-10-25T12:00:00.000Z") for the API.
 */
export function fromLocalDatetimeInputValue(localDatetimeValue?: string | null): string | null {
  if (!localDatetimeValue || !localDatetimeValue.trim()) return null;
  const date = new Date(localDatetimeValue);
  if (isNaN(date.getTime())) return null;
  return date.toISOString();
}

/**
 * Formats a date string into a user-friendly relative or localized date.
 */
export function formatDisplayDate(dateInput: string | Date | null | undefined): string {
  if (!dateInput) return "—";
  const date = typeof dateInput === "string" ? new Date(dateInput) : dateInput;
  if (isNaN(date.getTime())) return "—";

  return new Intl.DateTimeFormat(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(date);
}

/**
 * Determines if an expiration date has passed.
 */
export function isLinkExpired(expiresAt?: string | null): boolean {
  if (!expiresAt) return false;
  const exp = new Date(expiresAt).getTime();
  return !isNaN(exp) && exp <= Date.now();
}
